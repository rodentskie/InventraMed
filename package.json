{
  "name": "@inventramed/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx-parallel": "nx run-many -t $TASK --parallel 5",
    "nx-add": "nx add",
    "nx-daemon": "nx daemon --stop",
    "nx-reset": "nx reset",
    "nx-run": "nx $TASK $APP",
    "nx-show": "nx show project $APP",
    "nx-go:app-generate": "nx g @nx-go/nx-go:application $APP --directory apps/$APP",
    "nx-go:lib-generate": "nx g @nx-go/nx-go:library $APP  --directory libs/go/$APP",
    "next:app-generate": "nx g @nx/next:app $APP --directory apps/$APP",
    "next:lib-generate": "nx g @nx/next:lib $APP --directory libs/ts/$APP"
  },
  "private": true,
  "dependencies": {
    "@nx-go/nx-go": "4.1.1",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/next": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "nx": "23.2.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0"
  }
}
