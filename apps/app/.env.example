API_URL=http://localhost:8080
API_PREFIX=/api
# Seconds the scanner page's camera pauses after each scan before it can
# scan again. Exposed to the browser, so it must be NEXT_PUBLIC_.
NEXT_PUBLIC_SCANNER_COOLDOWN_SECONDS=5
# Hides the LED simulation panel (presets + per-LED toggles) on the live
# view page. Set to false to show it. Exposed to the browser, so it must be
# NEXT_PUBLIC_.
NEXT_PUBLIC_HIDE_LIVE_PRESETS=true
