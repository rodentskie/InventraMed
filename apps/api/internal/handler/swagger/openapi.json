      "SupplierResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/Supplier" }
        }
      },
      "SupplierListResponse": {
        "type": "object",
        "required": ["data", "total", "limit", "offset"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Supplier" }
          },
          "total": {
