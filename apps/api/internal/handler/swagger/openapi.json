{
  "openapi": "3.0.3",
  "info": {
    "title": "InventraMed API",
    "description": "REST API for the InventraMed medicine inventory system.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Default API prefix. Set by API_PREFIX."
    }
  ],
  "tags": [
    { "name": "root", "description": "Service information" },
    { "name": "auth", "description": "Authentication" },
    { "name": "medicines", "description": "Medicine inventory" },
    { "name": "inventory-entries", "description": "Manual stock adjustments" },
    { "name": "suppliers", "description": "Medicine suppliers" }
  ],
  "paths": {
    "/": {
      "servers": [
        {
          "url": "/",
          "description": "Served without the API prefix"
        }
      ],
      "get": {
        "tags": ["root"],
        "summary": "Root greeting",
        "operationId": "getRoot",
        "responses": {
          "200": {
            "description": "Greeting message",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GreetingResponse" }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Log in",
        "description": "Verifies the email and password and returns a signed access/refresh token pair.",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token pair",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid request body, email or password",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "email is required" }
              }
            }
          },
          "401": {
            "description": "Unknown email or wrong password",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "invalid credentials" }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "internal server error" }
              }
            }
          }
        }
      }
    },
    "/medicines": {
      "get": {
        "tags": ["medicines"],
        "summary": "List medicines",
        "description": "Returns one page of medicines, newest first. Deleted medicines are not listed. `name` and `barcode` match anywhere in the value, ignoring case; when both are given, both must match. `total` counts the medicines that match the filters, not the whole table.",
        "operationId": "listMedicines",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of medicines to skip.",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Only medicines whose name contains this text, ignoring case.",
            "schema": { "type": "string", "maxLength": 255 },
            "example": "para"
          },
          {
            "name": "barcode",
            "in": "query",
            "description": "Only medicines whose barcode contains this text, ignoring case.",
            "schema": { "type": "string", "maxLength": 128 },
            "example": "890"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of medicines",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MedicineListResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "limit must be a whole number between 1 and 100" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "post": {
        "tags": ["medicines"],
        "summary": "Create a medicine",
        "description": "Registers a new medicine. Requires an access token in the Authorization header. The medicine is recorded as created by the token's user. A medicine is a duplicate when its name and batch number match an existing one (ignoring case), or when its barcode is already used, even by a deleted medicine.",
        "operationId": "createMedicine",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateMedicineRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The newly created medicine",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateMedicineResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid request body or field",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "quantity must be zero or greater" }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, expired or non-access token",
            "headers": {
              "WWW-Authenticate": {
                "description": "Authentication scheme required",
                "schema": { "type": "string", "example": "Bearer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "unauthorized" }
              }
            }
          },
          "409": {
            "description": "A medicine with the same name and batch number, or the same barcode, already exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "nameAndBatch": {
                    "summary": "Same name and batch number",
                    "value": { "error": "medicine with this name and batch number already exists" }
                  },
                  "barcode": {
                    "summary": "Same barcode",
                    "value": { "error": "medicine with this barcode already exists" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "internal server error" }
              }
            }
          }
        }
      }
    },
    "/medicines/barcode/{barcode}": {
      "get": {
        "tags": ["medicines"],
        "summary": "Get a medicine by barcode",
        "description": "Returns the medicine whose barcode matches exactly. A deleted medicine is not found.",
        "operationId": "getMedicineByBarcode",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "barcode",
            "in": "path",
            "required": true,
            "description": "Barcode as read by the scanner. URL-encode reserved characters.",
            "schema": { "type": "string", "maxLength": 128 },
            "example": "8901234567890"
          }
        ],
        "responses": {
          "200": {
            "description": "The medicine",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MedicineResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid barcode",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "barcode is too long" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/MedicineNotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/medicines/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Medicine ID.",
          "schema": { "type": "string", "format": "uuid" },
          "example": "0b8f3c62-6a1e-4c3e-9d0e-5f1d2a7c9e11"
        }
      ],
      "put": {
        "tags": ["medicines"],
        "summary": "Update a medicine",
        "description": "Replaces the medicine's name, barcode, batch number and expiration date; an omitted batch number is cleared. The quantity cannot be changed here, and a `quantity` in the body is ignored. The medicine's own current values never count as duplicates. Otherwise a duplicate is another medicine with the same name and batch number (ignoring case), or the same barcode, even a deleted one's.",
        "operationId": "updateMedicine",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateMedicineRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "The medicine was updated" },
          "400": {
            "description": "Invalid medicine id, request body or field",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "invalidId": {
                    "summary": "The id is not a UUID",
                    "value": { "error": "invalid medicine id" }
                  },
                  "invalidField": {
                    "summary": "A field failed validation",
                    "value": { "error": "expiration_date must be a valid date in YYYY-MM-DD format" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/MedicineNotFound" },
          "409": {
            "description": "Another medicine has the same name and batch number, or the same barcode",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "nameAndBatch": {
                    "summary": "Same name and batch number",
                    "value": { "error": "medicine with this name and batch number already exists" }
                  },
                  "barcode": {
                    "summary": "Same barcode",
                    "value": { "error": "medicine with this barcode already exists" }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["medicines"],
        "summary": "Delete a medicine",
        "description": "Soft-deletes the medicine. It is refused while any purchase order that has not been deleted has an item for it, whatever the order's status. A deleted medicine keeps its barcode locked, so the barcode cannot be reused.",
        "operationId": "deleteMedicine",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "The medicine was deleted" },
          "400": {
            "description": "Invalid medicine id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "invalid medicine id" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/MedicineNotFound" },
          "409": {
            "description": "A purchase order uses the medicine",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "medicine is used in a purchase order and cannot be deleted" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/inventory-entries": {
      "get": {
        "tags": ["inventory-entries"],
        "summary": "List inventory entries",
        "description": "Returns one page of inventory entries, newest first.",
        "operationId": "listInventoryEntries",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of entries to skip.",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of inventory entries",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InventoryEntryListResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "limit must be a whole number between 1 and 100" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "post": {
        "tags": ["inventory-entries"],
        "summary": "Record a stock adjustment",
        "description": "Creates a manual stock adjustment for a medicine. Entries are append-only: correcting a mistake means recording a new offsetting entry, not editing or deleting this one. The entry is recorded as counted by the token's user. `medicines.quantity` updates automatically from the entry via a database trigger. A `subtraction` that would take the medicine's quantity below zero is refused.",
        "operationId": "createInventoryEntry",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateInventoryEntryRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The newly recorded inventory entry",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InventoryEntryResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid request body or field",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "quantity must be greater than zero" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "medicine_id does not reference an active medicine",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "medicine not found" }
              }
            }
          },
          "409": {
            "description": "A subtraction would take the medicine's quantity below zero",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "insufficient quantity for subtraction" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/inventory-entries/{id}": {
      "get": {
        "tags": ["inventory-entries"],
        "summary": "Get an inventory entry",
        "operationId": "getInventoryEntry",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Inventory entry ID.",
            "schema": { "type": "string", "format": "uuid" },
            "example": "3a1e2c4f-6a1e-4c3e-9d0e-5f1d2a7c9e11"
          }
        ],
        "responses": {
          "200": {
            "description": "The inventory entry",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InventoryEntryResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid inventory entry id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "invalid inventory entry id" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "No inventory entry with that id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "inventory entry not found" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/suppliers": {
      "get": {
        "tags": ["suppliers"],
        "summary": "List suppliers",
        "description": "Returns one page of suppliers, newest first. Deleted suppliers are not listed. `name` matches anywhere in the supplier's name, ignoring case. `total` counts the suppliers that match the filter, not the whole table. An offset past the end returns an empty page with the real total.",
        "operationId": "listSuppliers",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of suppliers to skip.",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Only suppliers whose name contains this text, ignoring case.",
            "schema": { "type": "string", "maxLength": 255 },
            "example": "acme"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of suppliers",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SupplierListResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "limit must be a whole number between 1 and 100" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "post": {
        "tags": ["suppliers"],
        "summary": "Create a supplier",
        "description": "Registers a new supplier. Requires an access token in the Authorization header. Suppliers have no uniqueness rule, so two suppliers may share a name, email or phone. Optional fields that are empty are stored as no value.",
        "operationId": "createSupplier",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSupplierRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The newly created supplier",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateSupplierResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid request body or field",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "email must be a valid email address" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/suppliers/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Supplier ID.",
          "schema": { "type": "string", "format": "uuid" },
          "example": "b1a2c3d4-6a1e-4c3e-9d0e-5f1d2a7c9e11"
        }
      ],
      "get": {
        "tags": ["suppliers"],
        "summary": "Get a supplier",
        "operationId": "getSupplier",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The supplier",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SupplierResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid supplier id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "invalid supplier id" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/SupplierNotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["suppliers"],
        "summary": "Update a supplier",
        "description": "Replaces the supplier's name, contact name, email, phone and address; an omitted or empty optional field is cleared.",
        "operationId": "updateSupplier",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateSupplierRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "The supplier was updated" },
          "400": {
            "description": "Invalid supplier id, request body or field",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "invalidId": {
                    "summary": "The id is not a UUID",
                    "value": { "error": "invalid supplier id" }
                  },
                  "invalidField": {
                    "summary": "A field failed validation",
                    "value": { "error": "name is required" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/SupplierNotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["suppliers"],
        "summary": "Delete a supplier",
        "description": "Soft-deletes the supplier. It is refused while any purchase order that has not been deleted references it, whatever the order's status.",
        "operationId": "deleteSupplier",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "The supplier was deleted" },
          "400": {
            "description": "Invalid supplier id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "invalid supplier id" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/SupplierNotFound" },
          "409": {
            "description": "A purchase order uses the supplier",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "supplier is used in a purchase order and cannot be deleted" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Missing, malformed, expired or non-access token",
        "headers": {
          "WWW-Authenticate": {
            "description": "Authentication scheme required",
            "schema": { "type": "string", "example": "Bearer" }
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "error": "unauthorized" }
          }
        }
      },
      "MedicineNotFound": {
        "description": "No medicine with that id or barcode, or it was deleted",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "error": "medicine not found" }
          }
        }
      },
      "SupplierNotFound": {
        "description": "No supplier with that id, or it was deleted",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "error": "supplier not found" }
          }
        }
      },
      "InternalServerError": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "error": "internal server error" }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token from POST /login, sent as `Authorization: Bearer <token>`. Refresh tokens are rejected."
      }
    },
    "schemas": {
      "GreetingResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "example": "inventramed REST API" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "admin@example.com" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": ["access_token", "refresh_token"],
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" }
        }
      },
      "CreateMedicineRequest": {
        "type": "object",
        "required": ["name", "barcode", "expiration_date", "quantity"],
        "properties": {
          "name": { "type": "string", "maxLength": 255, "example": "Paracetamol 500mg" },
          "barcode": {
            "type": "string",
            "maxLength": 128,
            "description": "Read by the scanner. Must be unique across all medicines, including deleted ones.",
            "example": "8901234567890"
          },
          "batch_number": {
            "type": "string",
            "nullable": true,
            "maxLength": 64,
            "description": "Optional. An empty value is stored as no batch number.",
            "example": "B2026-001"
          },
          "expiration_date": {
            "type": "string",
            "format": "date",
            "description": "Past dates are allowed.",
            "example": "2027-03-31"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "description": "Starting stock count.",
            "example": 120
          }
        }
      },
      "Medicine": {
        "type": "object",
        "required": ["id", "name", "barcode", "batch_number", "expiration_date", "quantity", "created_by", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "example": "0b8f3c62-6a1e-4c3e-9d0e-5f1d2a7c9e11" },
          "name": { "type": "string", "example": "Paracetamol 500mg" },
          "barcode": { "type": "string", "example": "8901234567890" },
          "batch_number": { "type": "string", "nullable": true, "example": "B2026-001" },
          "expiration_date": { "type": "string", "format": "date", "example": "2027-03-31" },
          "quantity": { "type": "integer", "example": 120 },
          "created_by": { "type": "string", "format": "uuid", "nullable": true, "example": "7d2f4a10-3b5c-4e8a-a1f6-9c0b2d4e6f88" },
          "created_at": { "type": "string", "format": "date-time", "example": "2026-09-20T08:15:30Z" },
          "updated_at": { "type": "string", "format": "date-time", "example": "2026-09-20T08:15:30Z" }
        }
      },
      "CreateMedicineResponse": {
        "type": "object",
        "required": ["message", "data"],
        "properties": {
          "message": { "type": "string", "example": "medicine created" },
          "data": { "$ref": "#/components/schemas/Medicine" }
        }
      },
      "UpdateMedicineRequest": {
        "type": "object",
        "required": ["name", "barcode", "expiration_date"],
        "properties": {
          "name": { "type": "string", "maxLength": 255, "example": "Paracetamol 500mg" },
          "barcode": {
            "type": "string",
            "maxLength": 128,
            "description": "Must be unique across all medicines, including deleted ones.",
            "example": "8901234567890"
          },
          "batch_number": {
            "type": "string",
            "nullable": true,
            "maxLength": 64,
            "description": "Optional. An empty or omitted value clears the batch number.",
            "example": "B2026-002"
          },
          "expiration_date": {
            "type": "string",
            "format": "date",
            "description": "Past dates are allowed.",
            "example": "2027-06-30"
          }
        }
      },
      "MedicineResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/Medicine" }
        }
      },
      "MedicineListResponse": {
        "type": "object",
        "required": ["data", "total", "limit", "offset"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Medicine" }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Number of medicines matching the filters, across all pages.",
            "example": 57
          },
          "limit": { "type": "integer", "example": 20 },
          "offset": { "type": "integer", "example": 0 }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "CreateInventoryEntryRequest": {
        "type": "object",
        "required": ["medicine_id", "direction", "quantity", "reason"],
        "properties": {
          "medicine_id": { "type": "string", "format": "uuid", "example": "0b8f3c62-6a1e-4c3e-9d0e-5f1d2a7c9e11" },
          "direction": {
            "type": "string",
            "enum": ["addition", "subtraction"],
            "example": "subtraction"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "description": "The amount being added or subtracted.",
            "example": 5
          },
          "reason": {
            "type": "string",
            "maxLength": 100,
            "description": "Free text, e.g. count_adjustment, returned, damaged, lost, expired_removal.",
            "example": "damaged"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 500,
            "description": "Optional. An empty or omitted value is stored as no notes.",
            "example": "water damage during storage"
          }
        }
      },
      "InventoryEntry": {
        "type": "object",
        "required": ["id", "medicine_id", "direction", "quantity", "reason", "counted_by", "notes", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "example": "3a1e2c4f-6a1e-4c3e-9d0e-5f1d2a7c9e11" },
          "medicine_id": { "type": "string", "format": "uuid", "example": "0b8f3c62-6a1e-4c3e-9d0e-5f1d2a7c9e11" },
          "direction": { "type": "string", "enum": ["addition", "subtraction"], "example": "subtraction" },
          "quantity": { "type": "integer", "example": 5 },
          "reason": { "type": "string", "example": "damaged" },
          "counted_by": { "type": "string", "format": "uuid", "example": "7d2f4a10-3b5c-4e8a-a1f6-9c0b2d4e6f88" },
          "notes": { "type": "string", "nullable": true, "example": "water damage during storage" },
          "created_at": { "type": "string", "format": "date-time", "example": "2026-09-20T08:15:30Z" }
        }
      },
      "InventoryEntryResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/InventoryEntry" }
        }
      },
      "InventoryEntryListResponse": {
        "type": "object",
        "required": ["data", "total", "limit", "offset"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/InventoryEntry" }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Number of inventory entries, across all pages.",
            "example": 42
          },
          "limit": { "type": "integer", "example": 20 },
          "offset": { "type": "integer", "example": 0 }
        }
      },
      "CreateSupplierRequest": {
        "type": "object",
        "required": ["name"],
        "description": "All string fields are trimmed before they are validated.",
        "properties": {
          "name": { "type": "string", "maxLength": 255, "example": "Acme Pharma Distribution" },
          "contact_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 255,
            "description": "Optional. An empty or omitted value is stored as no value.",
            "example": "Jane Cruz"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "maxLength": 255,
            "description": "Optional. Must be a valid email address when given.",
            "example": "jane@acmepharma.example"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 32,
            "description": "Optional. An empty or omitted value is stored as no value.",
            "example": "+63 917 123 4567"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "maxLength": 500,
            "description": "Optional. An empty or omitted value is stored as no value.",
            "example": "123 Industrial Ave, Quezon City"
          }
        }
      },
      "UpdateSupplierRequest": {
        "type": "object",
        "required": ["name"],
        "description": "Same shape as the create request. An update replaces every field, so an omitted optional field is cleared.",
        "properties": {
          "name": { "type": "string", "maxLength": 255, "example": "Acme Pharma Distribution" },
          "contact_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 255,
            "description": "Optional. An empty or omitted value is stored as no value.",
            "example": "Jane Cruz"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "maxLength": 255,
            "description": "Optional. Must be a valid email address when given. An empty or omitted value clears it.",
            "example": "jane@acmepharma.example"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 32,
            "description": "Optional. An empty or omitted value is stored as no value.",
            "example": "+63 917 123 4567"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "maxLength": 500,
            "description": "Optional. An empty or omitted value is stored as no value.",
            "example": "123 Industrial Ave, Quezon City"
          }
        }
      },
      "Supplier": {
        "type": "object",
        "required": ["id", "name", "contact_name", "email", "phone", "address", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "example": "b1a2c3d4-6a1e-4c3e-9d0e-5f1d2a7c9e11" },
          "name": { "type": "string", "example": "Acme Pharma Distribution" },
          "contact_name": { "type": "string", "nullable": true, "example": "Jane Cruz" },
          "email": { "type": "string", "nullable": true, "example": "jane@acmepharma.example" },
          "phone": { "type": "string", "nullable": true, "example": "+63 917 123 4567" },
          "address": { "type": "string", "nullable": true, "example": "123 Industrial Ave, Quezon City" },
          "created_at": { "type": "string", "format": "date-time", "example": "2026-09-20T08:15:30Z" },
          "updated_at": { "type": "string", "format": "date-time", "example": "2026-09-20T08:15:30Z" }
        }
      },
      "CreateSupplierResponse": {
        "type": "object",
        "required": ["message", "data"],
        "properties": {
          "message": { "type": "string", "example": "supplier created" },
          "data": { "$ref": "#/components/schemas/Supplier" }
        }
