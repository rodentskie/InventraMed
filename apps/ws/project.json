{
  "name": "ws",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ws",
  "targets": {
    "build": {
      "options": {
        "main": "./cmd/ws"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "gow run ./cmd/ws"
        ],
        "parallel": false
      }
    },
    "test": {
      "options": {
        "cover": true
      }
    }
  },
  "tags": []
}
